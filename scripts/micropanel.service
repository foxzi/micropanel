[Unit]
Description=MicroPanel - Static Hosting Control Panel
After=network.target nginx.service
Wants=nginx.service

[Service]
Type=simple
User=micropanel
Group=micropanel
ExecStart=/usr/bin/micropanel serve
Restart=on-failure
RestartSec=5

# Ensure /var/lib/micropanel exists with correct ownership on every start.
# Removes the race between dpkg/nfpm chown in postinstall and systemd restart.
StateDirectory=micropanel
StateDirectoryMode=0750

# Security
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/micropanel /var/www/panel/sites /etc/nginx/sites-enabled /run /var/log/nginx /var/log/letsencrypt /etc/letsencrypt /var/lib/letsencrypt /var/www/certbot
PrivateTmp=true

[Install]
WantedBy=multi-user.target
